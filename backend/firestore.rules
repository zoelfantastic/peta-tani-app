rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users: petani reads own profile; admin reads all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Region data is read-only for any authenticated user (cached by SDK)
    match /regions/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Aktivitas: owner has full access; admin can read all
    match /aktivitas/{aktivitasId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Lahan: owner has full access; admin can read all
    match /lahan/{lahanId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Admins collection is managed exclusively via Admin SDK
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
